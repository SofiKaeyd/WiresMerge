  - Id: 43
    Speaker: "\u042D\u043D\u0437\u043E \u0424\u0430\u0440\u043D"
    Text: "\u0421\u043C\u043E\u0442\u0440\u044F, \u043E \u0447\u0451\u043C \u0442\u044B
      \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0448\u044C. \u0415\u0441\u043B\u0438
      \u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u0442\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E.
      \u042F \u043F\u043E\u0447\u0442\u0438 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B."
    IsPlayer: 0
    Parameters: 
    Conditions: 
    IsCorrect: 1
    SourceImageUrl: 
