    ParentIds: 34010000
    ChildrenIds: 
  - Id: 311
    Speaker: Answer
    Text: "\u0412 \u043F\u0435\u0440\u0438\u043E\u0434 \u0440\u0443\u0442\u0438\u043D\u043D\u044B\u0445
      \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0439, \u043A\u043E\u0433\u0434\u0430
      \u0432\u044B\u0441\u043E\u043A\u0430\u044F \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C
      \u043D\u0435 \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u0430."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
