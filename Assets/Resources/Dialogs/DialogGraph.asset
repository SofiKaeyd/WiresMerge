    InlineImageAsset: {fileID: 0}
    ParentIds: 34010000
    ChildrenIds: 
  - Id: 312
    Speaker: Answer
    Text: "\u0422\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u0433\u0434\u0430 \u0434\u0435\u043D\u044C."
