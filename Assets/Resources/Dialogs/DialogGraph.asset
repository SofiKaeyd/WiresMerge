  - Id: 32
    Speaker: "\u042D\u043D\u0437\u043E \u0424\u0430\u0440\u043D"
    Text: "\u041F\u043E\u043F\u0440\u0438\u0434\u0435\u0440\u0436\u0438 \u043A\u043E\u043D\u0435\u0439!
      \u0413\u043E\u043D\u0438\u0441\u044C \u043D\u0435 \u0437\u0430 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C\u044E,
      \u0430 \u0437\u0430 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E\u043C.
      \u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u0442\u0430\u043A \u043D\u0435
      \u0434\u043E\u0440\u0430\u0441\u0442\u0435\u0448\u044C \u0434\u043E \u043C\u043E\u0435\u0433\u043E
      \u0443\u0440\u043E\u0432\u043D\u044F."
    IsPlayer: 0
    Parameters: 
    Conditions: 
    IsCorrect: 1
    SourceImageUrl: 
    RecipientImageUrl: 
    InlineImageAsset: {fileID: 0}
    ParentIds: 1e000000
    ChildrenIds: 22000000
  - Id: 33
    Speaker: "\u042D\u043D\u0437\u043E \u0424\u0430\u0440\u043D"
    Text: "\u0422\u044B \u043F\u0440\u0438\u0448\u0435\u043B \u0441\u044E\u0434\u0430,
      \u0447\u0442\u043E\u0431\u044B \u0441\u0442\u0430\u0442\u044C \u0447\u0430\u0441\u0442\u044C\u044E
      \u0447\u0435\u0433\u043E-\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E
      \u0438\u043B\u0438 \u0447\u0442\u043E\u0431\u044B \u043B\u0435\u043D\u0438\u0442\u044C\u0441\u044F?!
      \u0410 \u043D\u0443 \u0441\u043E\u0431\u0440\u0430\u043B\u0441\u044F \u0438
      \u0441\u0434\u0435\u043B\u0430\u043B."
