      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E, \u0441\u0435\u0439\u0447\u0430\u0441
      \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u0442 \u044D\u043D\u0435\u0440\u0433\u0438\u0438
      \u0434\u043B\u044F \u043F\u0443\u0441\u043A\u0430. \u0410 \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u0442
      \u2013 \u0431\u0443\u0434\u0435\u0442 \u0442\u0435\u043C\u043D\u043E. \u0418
      \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0443 \u043D\u0430\u0441."
