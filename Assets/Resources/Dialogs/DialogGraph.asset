    InlineImageAsset: {fileID: 0}
    ParentIds: 34010000
    ChildrenIds: 
  - Id: 310
    Speaker: Answer
    Text: "\u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u2013 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u044B\u0439
      \u0440\u0435\u0436\u0438\u043C \u0434\u043B\u044F \u043B\u0435\u043D\u0438\u0432\u044B\u0445."
