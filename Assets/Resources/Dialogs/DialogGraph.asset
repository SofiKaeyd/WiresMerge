    Text: "\u042F \u0431\u0443\u0434\u0443 \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0442\u044C
      \u0438\u043D\u0434\u0438\u043A\u0430\u0442\u043E\u0440\u044B \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F
      \u0438 \u043F\u0440\u043E\u0439\u0434\u0443\u0441\u044C \u043F\u043E \u0432\u0441\u0435\u043C
      \u0433\u043E\u0442\u043E\u0432\u044B\u043C \u043C\u043E\u0434\u0443\u043B\u044F\u043C.
      \u0412 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u043D\u0435\u043B\u044C\u0437\u044F
