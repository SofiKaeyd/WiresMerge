    ParentIds: 2a000000
    ChildrenIds: 27000000
  - Id: 46
    Speaker: "\u042D\u043D\u0437\u043E \u0424\u0430\u0440\u043D"
    Text: "\u042D\u0442\u043E \u043A\u043B\u044E\u0447\u0435\u0432\u043E\u0439 \u044D\u0442\u0430\u043F.
      \u042F \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
      \u043F\u0435\u0440\u0432\u044B\u0439 \u043F\u0443\u0441\u043A \u0432 \u0440\u0435\u0436\u0438\u043C\u0435
      \u0441\u0430\u043C\u043E\u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438.
      \u0415\u0441\u043B\u0438 \u0432\u0441\u0451 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435,
      \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0434\u043E\u043B\u0436\u043D\u0430
      \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C.  "
