      \u0432\u043E\u0434\u043E\u043D\u0430\u0433\u0440\u0435\u0432\u0430\u0442\u0435\u043B\u044C
      \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A
      \u043D\u0430 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u044B\u0439
      \u0440\u0435\u0436\u0438\u043C; \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0435 \u0436\u0438\u0437\u043D\u0435\u043D\u043D\u043E
