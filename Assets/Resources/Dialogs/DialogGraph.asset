  - Id: 118
    Speaker: "\u042D\u043D\u0437\u043E \u0424\u0430\u0440\u043D"
    Text: "\u041C\u043E\u043D\u0438\u0442\u043E\u0440\u0438\u043B \u0434\u0432\u0430
      \u043C\u043E\u0434\u0443\u043B\u044F, \u0434\u0430\u043D\u043D\u044B\u0435
      \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u0443\u0436\u0435
      \u0437\u0430\u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043B \u0440\u0430\u043D\u0435\u0435.
      \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u043E\u0432
